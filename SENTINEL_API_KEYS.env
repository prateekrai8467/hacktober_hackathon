# ==============================================================
#  SENTINEL — API KEYS CONFIGURATION
#  Fill in your keys below and rename this file to: .env
#  Then place it in: backend/.env  AND  frontend/.env
# ==============================================================

# ── NEON POSTGRESQL (Primary Database) ──────────────────────
# Sign up free at: https://neon.tech
# Get your connection string from: Project > Connection Details
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/sentinel?sslmode=require

# ── SUPABASE (Auth + File Storage SDK) ──────────────────────
# Sign up free at: https://supabase.com
# Get from: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ── SUPABASE STORAGE (File Storage — uses existing Supabase keys) ─
# No additional signup needed — uses your SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# Just create a public bucket called "sentinel-media" in Supabase Dashboard → Storage
SUPABASE_STORAGE_BUCKET=sentinel-media

# ── NEON / S3 OBJECT STORAGE (File & Satellite Storage) ───────────
AWS_ENDPOINT_URL_S3=https://your-storage.neon.tech
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=sentinel-media

# ── SENTINEL HUB (Satellite Imagery) ─────────────────────────
# Sign up free at: https://sentinelhub.com
# Get from: User Settings > OAuth clients
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# ── NASA EARTHDATA (FIRMS Fire Hotspots + SRTM Elevation) ────
# Register free at: https://urs.earthdata.nasa.gov
# FIRMS API key from: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_EARTHDATA_USERNAME=your_nasa_username
NASA_EARTHDATA_PASSWORD=your_nasa_password
NASA_FIRMS_API_KEY=your_firms_api_key

# ── GROQ API (AI Report Generation — llama-3.1-70b) ──────────
# Sign up free at: https://console.groq.com
# Get from: API Keys tab
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── GOOGLE GEMINI API (Vision Analysis) ──────────────────────
# Free tier: 1,500 requests/day
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ── HUGGING FACE (Building Damage Classification) ─────────────
# Sign up free at: https://huggingface.co
# Get from: Settings > Access Tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# ── OPENWEATHERMAP (Weather Context) ─────────────────────────
# Sign up free at: https://openweathermap.org/api
# Get from: My API Keys tab (1,000 calls/day free)
OPENWEATHER_API_KEY=your_openweather_api_key

# ── APP CONFIGURATION ─────────────────────────────────────────
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=10

# ==============================================================
#  FRONTEND-ONLY VARIABLES (prefix with VITE_ for Vite to expose)
#  Copy these to frontend/.env
# ==============================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_MAPBOX_TOKEN=
