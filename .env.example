# ==============================================================
#  TERASCOPE / SENTINEL — Environment Configuration Template
#  Copy this file to: backend/.env AND frontend/.env
#  Fill in the respective values for your local environment.
# ==============================================================

# ── Primary Database (Neon PostgreSQL with PostGIS) ───────────
NEON_DATABASE_URL=postgresql://user:password@ep-sample-project.us-east-2.aws.neon.tech/sentinel?sslmode=require

# ── Supabase (Authentication & Storage) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=sentinel-media

# ── S3 / Object Storage (Optional fallback) ───────────────────
AWS_ENDPOINT_URL_S3=https://your-storage.neon.tech
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=sentinel-media

# ── Satellite Imagery & Earth Data Feeds ──────────────────────
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret
NASA_EARTHDATA_USERNAME=your_nasa_username
NASA_EARTHDATA_PASSWORD=your_nasa_password
NASA_FIRMS_API_KEY=your_firms_api_key

# ── AI Inference Services ─────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=AIza_your_gemini_api_key
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# ── Map & Geocoding Providers ─────────────────────────────────
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# ── Server Configuration ──────────────────────────────────────
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend Public Variables (Vite prefixed) ─────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_GEMINI_API_KEY=AIza_your_gemini_api_key
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token
